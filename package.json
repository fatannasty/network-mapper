{
  "name": "network-mapper",
  "version": "1.0.0",
  "description": "Web-based network topology mapper with auto-discovery",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "scan": "node server.js --scan-only",
    "watch": "./auto-push.sh",
    "tunnel": "cloudflared tunnel --config cloudflared-config.yml run",
    "setup-tunnel": "./setup-tunnel.sh",
    "deploy": "./deploy.sh"
  },
  "dependencies": {
    "express": "^4.18.0",
    "jszip": "^3.10.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
